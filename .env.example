# Скопируй этот файл в .env и заполни своими значениями.
# .env НИКОГДА не должен попадать в GitHub — он уже в .gitignore.

# Discord Developer Portal → Bot → Token
DISCORD_TOKEN=

# Discord Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=

# ID твоего Discord-сервера (правый клик по серверу → Copy Server ID,
# нужен включённый Developer Mode). Если оставить пустым — команды
# зарегистрируются глобально (обновление до 1 часа вместо мгновенного).
DISCORD_GUILD_ID=

# ID роли, которой разрешено использовать команды выдачи рангов и бана.
# Если оставить пустым — команды сможет использовать ЛЮБОЙ участник сервера (не рекомендуется).
DISCORD_ALLOWED_ROLE_ID=

# Roblox Creator Dashboard → API Keys → создать ключ с доступом
# Datastore API (Read/Write) для нужного Universe (игры).
ROBLOX_API_KEY=

# Roblox: Game Settings → Basic Info → Universe ID твоей игры (число).
ROBLOX_UNIVERSE_ID=

# Порт, который слушает мини HTTP-сервер (Render подставит сам, менять не нужно)
PORT=3000
